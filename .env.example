# OpenAI-compatible 服务地址，例如 http://localhost:11434/v1
RESUME_AI_BASE_URL=
# 线上服务密钥；本地 Ollama 通常不需要
RESUME_AI_API_KEY=
# 服务端模型名称
RESUME_AI_MODEL=
# 单次模型调用超时（秒）
RESUME_AI_TIMEOUT_SECONDS=20
# 是否启用模型调用和失败降级；命令行参数优先级更高
RESUME_AI_ENABLED=true
RESUME_AI_FALLBACK_ENABLED=true
RESUME_AI_PROVIDER=openai
RESUME_AI_RESPONSE_PATH=
RESUME_AI_CONTENT_TYPE=text
